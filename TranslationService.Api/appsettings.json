{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Translation": {
    "TargetLanguage": "es"
  },
  "MessageQueue": {
    "Capacity": 1000,
    "MaxDegreeOfParallelism": 4
  },
  "AzureTranslator": {
    "Endpoint": "https://api.cognitive.microsofttranslator.com",
    "ApiVersion": "3.0",
    "Resilience": {
      "MaxRetryAttempts": 3,
      "RetryBaseDelay": "00:00:00.400",
      "CircuitBreakerFailureRatio": 0.5,
      "CircuitBreakerSamplingDuration": "00:00:30",
      "CircuitBreakerBreakDuration": "00:00:15",
      "CircuitBreakerMinimumThroughput": 4,
      "AttemptTimeout": "00:00:10",
      "TotalTimeout": "00:00:45"
    }
  }
}
