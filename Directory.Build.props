<Project>

  <!-- Decisión: propiedades centralizadas para garantizar homogeneidad entre las 7 cabeceras
       de proyecto. TreatWarningsAsErrors actúa como red de seguridad: en una base de código
       con nullable habilitado, un warning ignorado suele ser un NullReferenceException futuro. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
