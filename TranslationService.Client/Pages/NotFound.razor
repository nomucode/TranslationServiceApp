@* App.razor la referencia como NotFoundPage, lo que exige que el tipo tenga una ruta. *@
@page "/no-encontrado"

<PageTitle>Página no encontrada</PageTitle>

<div class="flex h-dvh flex-col items-center justify-center gap-4 bg-canvas px-4 text-center">
    <p class="text-sm font-medium text-content-muted">Error 404</p>
    <h1 class="text-xl font-semibold">Esta página no existe</h1>
    <a href="/" class="text-sm font-medium text-brand underline underline-offset-4">Volver al traductor</a>
</div>
