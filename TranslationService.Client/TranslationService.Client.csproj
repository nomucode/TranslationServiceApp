<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- El Dockerfile genera el CSS en una etapa Node separada y lo copia ya construido,
         de modo que la imagen del SDK de .NET no necesita tener npm instalado. -->
    <SkipTailwindBuild Condition="'$(SkipTailwindBuild)' == ''">false</SkipTailwindBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TranslationService.Contracts\TranslationService.Contracts.csproj" />
  </ItemGroup>

  <!-- wwwroot/css/app.css lo genera Tailwind y NO se versiona (está en .gitignore), pero
       debe seguir siendo un static web asset normal: excluirlo del proyecto hacía que
       `dotnet publish` no lo copiara y la aplicación se desplegara sin hoja de estilos.
       Sólo se veía en el contenedor, porque `dotnet run` sirve el fichero desde el disco. -->
  <ItemGroup>
    <TailwindInput Include="Styles/app.tailwind.css" />
    <TailwindSource Include="**/*.razor;**/*.html" Exclude="bin/**;obj/**;node_modules/**" />
  </ItemGroup>

  <!-- Instala dependencias sólo si faltan. La marca de tiempo de node_modules frente a
       package.json evita reinstalar en cada compilación. -->
  <Target Name="RestoreNpmPackages"
          BeforeTargets="BuildTailwindCss"
          Condition="'$(SkipTailwindBuild)' != 'true'"
          Inputs="package.json"
          Outputs="node_modules/.package-lock.json">
    <Message Importance="high" Text="Instalando dependencias npm del cliente..." />
    <Exec Command="npm install --no-audit --no-fund" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

  <!-- Inputs/Outputs dan incrementalidad: Tailwind sólo se reejecuta si cambió el tema o
       alguna clase en un .razor, no en cada compilación. -->
  <Target Name="BuildTailwindCss"
          BeforeTargets="BeforeBuild"
          Condition="'$(SkipTailwindBuild)' != 'true'"
          Inputs="@(TailwindInput);@(TailwindSource);package.json"
          Outputs="wwwroot/css/app.css">
    <Message Importance="high" Text="Generando CSS con Tailwind..." />
    <Exec Command="npm run build:css" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

</Project>
