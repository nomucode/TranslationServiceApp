<span class="@($"inline-block animate-spin rounded-full border-2 border-current/25 border-t-current {Class}")"
      role="status"
      aria-label="@Label"></span>

@code {
    [Parameter] public string Class { get; set; } = "size-4";
    [Parameter] public string Label { get; set; } = "Cargando";
}
